#!/usr/bin/env python3

import RPi.GPIO as GPIO
import time


# =====================================================
# PINOS DA MATRIZ
# =====================================================
#
# Freenove Projects Board
#
# DATA  -> GPIO22
# LATCH -> GPIO27
# CLOCK -> GPIO17
#
# =====================================================

DATA_PIN = 22
LATCH_PIN = 27
CLOCK_PIN = 17


# =====================================================
# GPIO
# =====================================================

GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)

GPIO.setup(DATA_PIN, GPIO.OUT)
GPIO.setup(LATCH_PIN, GPIO.OUT)
GPIO.setup(CLOCK_PIN, GPIO.OUT)

GPIO.output(DATA_PIN, GPIO.LOW)
GPIO.output(LATCH_PIN, GPIO.LOW)
GPIO.output(CLOCK_PIN, GPIO.LOW)


# =====================================================
# ENVIAR 8 BITS AO 74HC595
# =====================================================

def shift_out(value):

    for bit in range(8):

        GPIO.output(
            CLOCK_PIN,
            GPIO.LOW
        )

        mask = 0x80 >> bit

        if value & mask:
            GPIO.output(
                DATA_PIN,
                GPIO.HIGH
            )
        else:
            GPIO.output(
                DATA_PIN,
                GPIO.LOW
            )

        GPIO.output(
            CLOCK_PIN,
            GPIO.HIGH
        )


# =====================================================
# MOSTRAR UMA COLUNA
# =====================================================

def display_column(column, row_data):

    # Seleciona uma das 8 colunas
    column_mask = 0x80 >> column

    GPIO.output(
        LATCH_PIN,
        GPIO.LOW
    )

    # Primeiro byte:
    # linhas que queremos acender

    shift_out(
        row_data
    )

    # Segundo byte:
    # seleciona coluna
    #
    # seleção ativa em LOW

    shift_out(
        (~column_mask) & 0xFF
    )

    GPIO.output(
        LATCH_PIN,
        GPIO.HIGH
    )


# =====================================================
# APAGAR MATRIZ
# =====================================================

def clear_matrix():

    GPIO.output(
        LATCH_PIN,
        GPIO.LOW
    )

    shift_out(
        0x00
    )

    shift_out(
        0xFF
    )

    GPIO.output(
        LATCH_PIN,
        GPIO.HIGH
    )


# =====================================================
# MOSTRAR DESENHO 8x8
# =====================================================

def display_pattern(pattern, duration):

    start = time.time()

    while (
        time.time() - start
        < duration
    ):

        for column in range(8):

            row_data = 0

            for row in range(8):

                if pattern[row][column]:

                    row_data |= (
                        1 << row
                    )

            display_column(
                column,
                row_data
            )

            # multiplexação
            time.sleep(
                0.001
            )


